{
  "name": "@aaruni/sdk",
  "version": "1.0.0",
  "description": "Official Aaruni Cloud SDK & CLI for Aaruni Storage (ACS), Compute (ACC), Voice (AVA), Assistant (AAI), and Render (ARN).",
  "type": "module",
  "main": "./src/index.mjs",
