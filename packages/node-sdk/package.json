{
  "name": "@aarunicloud/sdk",
  "version": "1.0.0",
  "description": "Official Aaruni Cloud CLI (acloud) and Node.js/TypeScript SDK for Cloud Voice, Cloud Storage, Cloud Compute, and Cloud Assistant",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "acloud": "./bin/acloud.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "aarunicloud",
    "acloud",
    "cloud-voice",
    "voice-cloning",
    "cloud-storage"
  ],
  "author": "Aaruni Tech Private Limited",
  "license": "MIT"
}
